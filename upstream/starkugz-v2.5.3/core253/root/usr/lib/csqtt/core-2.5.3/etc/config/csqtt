# CSQTT — конфигурация OpenWrt (UCI, /etc/config/csqtt).
# Схема M4a: csqtt-openwrt/uci.rs (typed pool: main + routing + профили server).
# Правила контракта:
#   - интерфейс csqtt0 фиксирован (не UCI-поле);
#   - runtime-состояние — только /var/run/csqtt/status.json, никогда здесь;
#   - секреты (password, vk_js_token) через статусы/LuCI не выдаются;
#   - device_id привязан к паролю на сервере — переносить как есть, не генерировать.
# Профили удобнее добавлять CLI: csqtt profile import 'csqtt://…' --commit
# (или секцией config server ниже вручную).

config csqtt 'main'
	option schema_version '3'
	option enabled '0'
	# Имя TUN-интерфейса. Единственный экземпляр — csqtt0 (default); второй
	# экземпляр csqtt1 удалён (docs/panel-upgrade/DECISIONS.md D14).
	option ifname 'csqtt0'
	option selection_mode 'priority'
	option active_profile ''
	option failover '1'
	option failback '0'
	option health_interval '5'
	option fail_threshold '3'
	option success_threshold '2'
	option cooldown '60'
	option reconnect_delay '5'
	option failback_stable_time '60'
	option health_mode 'both'
	option health_target ''
	option captcha_policy 'failover'
	# [PER-PROFILE TUN] tun_address/tun_mtu/dns живут в каждой секции server
	# (см. шаблон профиля); здесь хранятся только до миграции (r26).
	option log_level 'info'
	option log_file '/var/log/csqtt.log'
	option log_size_kb '512'

# Контракт M3X: auto = interface-only (БЕЗ маршрутов/правил/таблиц — служба CSQTT их
# не ставит); none — отладочный алиас. Других режимов нет.
config csqtt 'routing'
	option mode 'auto'

# Шаблон профиля (раскомментировать и заполнить; enabled='1' только после
# проверки csqtt doctor):
#
# config server 'profile1'
# 	option name 'Main'
# 	option enabled '0'
# 	option priority '10'
# 	option peer '198.51.100.10:46000'
# 	option password 'SECRET'
# 	option vk 'hash1,hash2'
# 	option device_id 'uuid-привязан-к-паролю'
# 	option workers '18'
# 	option core_version '2.5.3'
# 	# Версия ядра выбирается только явно: '2.5.3' (единственное поставляемое
# 	# ядро) или '2.1.9' (legacy, явно отклоняется новым ядром). Значение
# 	# '2.5.0' принимается как миграционный алиас того же движка 2.5.3.
# 	# '2.5.3' запускает отдельный бинарник /usr/bin/csqtt-2.5.3
# 	# и подмене на 2.1.9 не подлежит.
# 	option obfs 'audio'
# 	# obfs: audio|video (оба ядра); unified — только core_version '2.5.3'.
# 	# audio: ChaCha20 на 2.1.9, SRTP на 2.5.3 (разные провода).
# 	option srtp_mode 'auto'
# 	# srtp_mode: auto|wrap|dtls — ключевой режим SRTP, ТОЛЬКО 2.5.3.
# 	# Это не режим obfs: obfs и srtp_mode независимы. Для 2.1.9 и auto
# 	# допустим только auto (у ядра нет такой опции; отказ, не игнор).
# 	option turn_transport 'udp'
# 	# [PER-PROFILE TUN] Туннельные параметры этой сессии: применяются при
# 	# переключении на этот профиль. Пустые = наследовать main (до миграции) /
# 	# дефолт (пустой адрес и DNS берутся из TUNCONF; MTU — 1280).
# 	option tun_address ''
# 	option tun_mtu '1280'
# 	option dns ''
# 	option fingerprint 'chrome'
