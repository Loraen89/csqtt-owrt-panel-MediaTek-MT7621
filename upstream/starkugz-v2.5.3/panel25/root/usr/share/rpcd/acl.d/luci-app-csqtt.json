			"ubus": {
				"csqtt": [
					"status",
					"engine_caps",
					"logs",
					"test_conf",
					"diag",
					"profiles",
					"settings",
					"hashes_validate",
					"shared_migrate_preview",
					"captcha_list",
					"captcha_helper_info",
					"check_updates",
					"update_status"
				]
			}
		},
