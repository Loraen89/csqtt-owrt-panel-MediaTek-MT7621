					"logs_clear",
					"service",
					"flood_clear",
					"access_check",
					"hash_recheck",
					"dns_rtt",
					"turn_probe",
					"test_conf",
					"profile_action",
					"profile_import",
					"profile_export",
					"profile_secret",
					"link_decrypt",
					"profile_save",
					"profile_priority",
					"settings_save",
					"shared_migrate_apply",
					"captcha_cancel",
					"captcha_helper_url",
					"profile_migrate_apply",
					"install_component"
				]
			}
		}
	}
}
