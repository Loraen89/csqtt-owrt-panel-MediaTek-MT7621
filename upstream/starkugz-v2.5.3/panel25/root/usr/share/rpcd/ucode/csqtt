function mCaptchaHelperInfo(req) {
	let inst = resolveInstance(req.args.instance);
	if (inst == null)
		return { ok: false, error: INSTANCE_ERR };
	let r = apiHttp(inst.helperPort, "GET", "/api/challenges");
	// [D5] Разделяем состояния: helper ВКЛЮЧЁН в настройках, ПРОЦЕСС поднят
	// (bind прошёл), порт СЛУШАЕТСЯ и адрес ДОСТУПЕН (реальный TCP-запрос rpcd на
	// loopback). Раньше `helper_running` считался как «status.json существует» и
	// показывал запущенный helper, когда его не было (живой дефект 2026-10-15:
	// `helper_running=true`, `reachable=false`, слушателя на 8443 нет).
	let st = readStatusJson(inst);
	let helper = (st != null && st.helper != null) ? st.helper : null;
	let enabled = (helper != null && helper.enabled == true);
	let running = (helper != null && helper.running == true);
	let listen = (helper != null && helper.listen != null) ? "" + helper.listen : "";
	let port = (helper != null && helper.port != null) ? int(helper.port) : inst.helperPort;
	let reachable = (r.ok && r.status == 200);
	let info = {
		instance: inst.key,
		// endpoint — loopback-адрес для вызовов rpcd (НЕ для браузера: URL для
		// телефона панель строит из своего origin, см. captcha.js).
		endpoint: "http://" + HELPER_HOST + ":" + inst.helperPort,
		port: inst.helperPort,
		helper_enabled: enabled,
		helper_running: running,
		listen: listen,
		reachable: reachable,
		captcha_pending: (st != null && st.captcha_pending != null ? st.captcha_pending : 0),
	};
	if (!reachable) {
		if (st == null)
			info.error = "служба CSQTT не запущена";
		else if (!enabled)
			info.error = "Web Helper выключен в настройках";
		else if (!running)
			info.error = "Web Helper включён, но не поднят (порт " + port + " не слушается)";
		else
			info.error = (r.error != null ? r.error : "служба Web Helper не отвечает на loopback");
	}
	return info;
}


// [063] Обновления: check — только чтение (ничего не устанавливает), install —
// один выбранный компонент после подтверждения. Оба пути идут через
// поставляемый установщик и фоновое задание, потому что скачивание и проверка
// SHA-256 не укладываются в лимит одного rpcd-вызова.
//
// Безопасность: из браузера принимаются только component ("core"/"panel") и
// confirm=true. Тег, линия OpenWrt, архитектура, формат IPK/APK, имена
// файлов, URL и SHA-256 определяются на роутере установщиком. Установка
// разрешена только по плану последней успешной проверки (UPD_PLAN): те же
// тег/имя/SHA-256/версия, что показаны пользователю. Второй запуск
// при незавершённом задании отклоняется (busy), у установщика есть и свой
// lock (код 40).

function updExists(path) {
	try { return fs.access(path) == true; } catch (e) { return false; }
}

function updRead(path) {
	try { return fs.readfile(path); } catch (e) { return null; }
}

function updWrite(path, txt) {
	let f;
	try {
		f = fs.open(path, "w", 384);   // 0600: каталог задания только root
	} catch (e) {
		return false;
	}
	if (f == null)
		return false;
	f.write(txt);
	f.close();
	return true;
}

function updRemove(path) {
	try { fs.unlink(path); } catch (e) {}
}

// pid жив, пока существует /proc/<pid>. Пустой/чужой pid — не живой.
function updAlive(pid) {
	if (pid == null || pid == "" || match(pid, UPD_PID_RE) == null)
		return false;
	return updExists("/proc/" + pid);
}

// "K:v|K:v" → объект. Значения маркеров не содержат `|`.
function updFields(parts, from) {
	let out = {};
	for (let i = from; i < length(parts); i++) {
		let p = parts[i];
		let c = index(p, ":");
		if (c > 0)
			out[substr(p, 0, c)] = substr(p, c + 1);
	}
	return out;
}

// [AUDIT-UTF8] length()/substr() в ucode считают БАЙТЫ. Обрезка по лимиту
// может разрезать многобайтовый символ UTF-8, и тогда сырой JSON-ответ RPC
// перестаёт быть валидным UTF-8 (строгие клиенты отказывают). Помощники ниже
// режут только по границе символа и ничего не добавляют: результат — префикс
// (или хвост) исходной строки. Вход, уже содержащий некорректный UTF-8, не
// «лечится» — это отдельный контракт: байты не заменяются на U+FFFD.
// 0 — байт продолжения (10xxxxxx) или недопустимый ведущий байт.
function utf8SeqLen(c) {
	if (c < 0x80)
		return 1;
	if ((c & 0xE0) == 0xC0)
		return 2;
	if ((c & 0xF0) == 0xE0)
		return 3;
	if ((c & 0xF8) == 0xF0)
		return 4;
	return 0;
}

// Не более max байт; граница не внутри символа (префикс исходной строки).
function utf8Prefix(txt, max) {
	if (max <= 0)
		return "";
	if (length(txt) <= max)
		return txt;
	let j = max;
	while (j > 0 && utf8SeqLen(ord(txt, j)) == 0)
		j--;
	if (j == 0)
		return "";
	let n = utf8SeqLen(ord(txt, j));
	if (n > 0 && j + n <= max)
		return substr(txt, 0, max);
	return substr(txt, 0, j);
}

// Не более max байт с конца, начало — на границе символа.
function utf8Tail(txt, max) {
	if (txt == null || max <= 0)
		return "";
	let len = length(txt);
	if (len <= max)
		return txt;
	let j = len - max;
	while (j < len && utf8SeqLen(ord(txt, j)) == 0)
		j++;
	return substr(txt, j);
}

// Строгая проверка UTF-8 на уровне последовательностей: продолжения, overlong,
// суррогаты и значения выше U+10FFFF отклоняются — так же, как строгий декодер.
// Нужна для ранее сохранённого повреждённого файла задания: такой текст нельзя
// отдавать в JSON, иначе сырой ответ снова станет невалидным.
const UTF8_MASK = [0x7F, 0x1F, 0x0F, 0x07];
const UTF8_MIN  = [0, 0x80, 0x800, 0x10000];
function utf8Valid(txt) {
	if (txt == null)
		return true;
	let n = length(txt), i = 0;
	while (i < n) {
		let c = ord(txt, i), k = utf8SeqLen(c);
		if (k == 0 || i + k > n)
			return false;
		let cp = c & UTF8_MASK[k - 1];
		for (let j = 1; j < k; j++) {
			let cc = ord(txt, i + j);
			if (cc < 0x80 || cc > 0xBF)
				return false;
			cp = (cp << 6) | (cc & 0x3F);
		}
		if (cp < UTF8_MIN[k - 1] || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF))
			return false;
		i += k;
	}
	return true;
}

function updTail(txt, max) {
	return utf8Tail(txt, max);
}

// Разбор маркеров установщика. Чего нет в журнале, того нет и в отчёте:
// состояние не выдумывается.
function updParse(txt) {
	let out = {
		system: null, release: null, components: {}, done: null,
		failed: null, check_failed: null, not_published: null,
		blocked: null, install_ok: null, rolled_back: null,
		artifact_changed: null,
	};
	if (txt == null)
		return out;
	let lines = split(replace(txt, TRAIL_NL, ""), "\n");
	for (let i = 0; i < length(lines); i++) {
		let line = lines[i];
		if (substr(line, 0, 16) != "CSQTT_INSTALLER_")
			continue;
		let parts = split(substr(line, 16), "|");
		let kind = parts[0];
		if (kind == "CHECK_BEGIN") {
			out.system = updFields(parts, 1);
		} else if (kind == "CHECK_RELEASE") {
			out.release = updFields(parts, 1);
		} else if (kind == "CHECK") {
			let f = updFields(parts, 1);
			if (f.component != null)
				out.components[f.component] = f;
		} else if (kind == "CHECK_DONE") {
			out.done = updFields(parts, 1);
		} else if (kind == "CHECK_FAILED") {
			out.check_failed = updFields(parts, 1);
		} else if (kind == "RELEASE_NOT_PUBLISHED") {
			out.not_published = updFields(parts, 1);
		} else if (kind == "RELEASE_BLOCKED") {
			out.blocked = updFields(parts, 1);
		} else if (kind == "ARTIFACT_CHANGED") {
			out.artifact_changed = updFields(parts, 1);
		} else if (kind == "FAILED") {
			// FAILED|<rc>|<сообщение, где тоже может быть |>
			let msg = "";
			for (let j = 2; j < length(parts); j++)
				msg += (j > 2 ? "|" : "") + parts[j];
			out.failed = { rc: parts[1], message: msg };
		} else if (kind == "OK") {
			out.install_ok = parts[1];
		} else if (kind == "ROLLED_BACK") {
			out.rolled_back = parts[1];
		}
	}
	return out;
}

// Состояние задания в UPD_DIR. rc отсутствует, пока задание выполняется;
// «вечный running» после kill -9/rpcd перезапуска исключён проверкой pid.
function updJob() {
	let st = { job: "", component: "", pid: "", rc: null, running: false, log: "", started: null };
	let v = updRead(UPD_DIR + "/job");
	if (v != null) st.job = strip(v);
	v = updRead(UPD_DIR + "/component");
	if (v != null) st.component = strip(v);
	v = updRead(UPD_DIR + "/pid");
	if (v != null) st.pid = strip(v);
	v = updRead(UPD_DIR + "/started");
	if (v != null) st.started = int(strip(v));
	st.log = updRead(UPD_DIR + "/log") || "";
	let rc = updRead(UPD_DIR + "/rc");
	if (rc != null) {
		st.rc = int(strip(rc));
		st.running = false;
	} else if (st.job != "") {
		if (st.pid != "" && !updAlive(st.pid)) {
			updWrite(UPD_DIR + "/rc", "-1\n");
			st.rc = -1;
			st.running = false;
		} else {
			st.running = true;
		}
	}
	return st;
}

// Строка компонента: установленная версия из базы пакетов + данные check.
function updComponent(marker, installedV) {
	let c = { state: "unknown", installed: installedV || "", available: "",
		name: "", sha256: "", bytes: 0 };
	if (marker != null) {
		if (marker.installed != null && marker.installed != "-")
			c.installed = marker.installed;
		if (marker.available != null && marker.available != "-")
			c.available = marker.available;
		if (marker.state != null)
			c.state = marker.state;
		if (marker.name != null)
			c.name = marker.name;
		if (marker.sha256 != null)
			c.sha256 = marker.sha256;
		if (marker.bytes != null && marker.bytes != "")
			c.bytes = int(marker.bytes);
	}
	return c;
}

// Итог: отдельно «выпуск не настроен», «не опубликован», «нет пакета»,
// «сеть» и «ошибка» — панель не смешивает их в одно сообщение.
function updResult(st, m) {
	if (st.running)
		return "running";
	if (m.artifact_changed != null)
		return "artifact_changed";
	if (m.not_published != null)
		return "not_published";
	if (m.blocked != null)
		return "not_configured";
	if (m.rolled_back != null)
		return "rolled_back";
	if (m.failed != null)
		return (match(m.failed.message, UPD_NET_RE) != null) ? "network" : "error";
	if (m.check_failed != null) {
		if (m.check_failed.stage == "release_api")
			return "network";
		if (m.check_failed.stage == "download" && m.check_failed.reason == "download")
			return "network";
		return "error";
	}
	if (m.install_ok != null)
		return "installed";
	if (m.done != null) {
		let no_pkg = false, update = false, unknown = false;
		for (let k in m.components) {
			let s = m.components[k].state;
			if (s == "no_package" || s == "ambiguous")
				no_pkg = true;
			else if (s == "update")
				update = true;
			else if (s == "unknown")
				unknown = true;
		}
		if (no_pkg)
			return "no_package";
		if (update)
			return "update";
		if (unknown)
			return "unknown";
		return "ok";
	}
	if (st.job == "")
		return "idle";
	if (st.rc != null && st.rc != 0)
		return "error";
	return "idle";
}

// Заметки выпуска: сохранённый установщиком JSON GitHub API, только `body`
// обычным текстом (не HTML) и тег. Секретов/токенов в теле нет.
function updNotes() {
	let txt = updRead(UPD_DIR + "/release.json");
	if (txt == null || txt == "")
		return null;
	let j = null;
	try { j = json(txt); } catch (e) { j = null; }
	if (j == null || type(j) != "object")
		return null;
	let body = (type(j.body) == "string") ? j.body : "";
	let tag = (type(j.tag_name) == "string") ? j.tag_name : "";
	// Повреждённый сохранённый файл (обрыв копирования и т.п.): не отдаём
	// невалидный UTF-8 в ответ и не подменяем символы. Заметки опускаются;
	// состояние задания не удаляется, новая проверка перезапишет release.json.
	if (!utf8Valid(tag) || !utf8Valid(body))
		return null;
	if (body == "" && tag == "")
		return null;
	// [AUDIT-UTF8] Обрезка по границе символа: сырой ответ остаётся валидным
	// UTF-8, текст заметок — корректным префиксом исходного.
	body = utf8Prefix(body, UPD_NOTES_MAX);
	return { tag: tag, body: body };
}

// Фоновый запуск установщика. Команда собирается только из констант и
// проверенных значений (component ∈ {core,panel}, action ∈ {install,update,
// check}, pin — значения из плана проверки); каждый argv-элемент экранирован
// shellquote. Установщик в пакете — скрипт без бита выполнения, поэтому он
// запускается как `sh <путь>`: это отдельные argv (без `-c`), сырой ввод в
// shell не попадает. stdio фоновой подоболочки отвязан от rpcd, иначе popen
// ждал бы её завершения.
function updSpawn(job, component, action, pin, coreVersion) {
	fs.mkdir(UPD_DIR, 0700);   // уже существует — не ошибка
	// Новая проверка отменяет прежний план: установка по устаревшему
	// подтверждению невозможна, пока проверка не завершится заново.
	if (job == "check")
		updRemove(UPD_PLAN);
	updRemove(UPD_DIR + "/rc");
	updRemove(UPD_DIR + "/pid");
	updRemove(UPD_DIR + "/log");
	updRemove(UPD_DIR + "/release.json");
	if (!updWrite(UPD_DIR + "/job", job + "\n"))
		return { ok: false, error: "не удалось создать каталог задания: " + UPD_DIR };
	updWrite(UPD_DIR + "/component", component + "\n");
	updWrite(UPD_DIR + "/started", "" + time() + "\n");

	let args = [TIMEOUT, "" + UPD_TMO, "sh", UPD_INSTALLER, action, "--set", component];
	if (coreVersion == "2.1.9" && component != "panel") {
		push(args, "--core-version");
		push(args, coreVersion);
	}
	// Привязка к проверке: ровно те значения, которые были показаны. Установщик
	// сверит имя и SHA-256 с манифестом тега и откажет, если выпуск изменился.
	if (pin != null) {
		push(args, "--pin-tag");       push(args, pin.tag);
		push(args, "--pin-name");      push(args, pin.name);
		push(args, "--pin-sha256");    push(args, pin.sha256);
		push(args, "--pin-version");   push(args, pin.version);
	}
	if (job == "install") {
		push(args, "--yes");
		// Панель не перезапускает службу: туннель не рвётся. Ядро
		// перезапускает службу установщик (это и есть явный переход).
		if (component == "panel")
			push(args, "--no-restart");
	}
	if (updExists(UPD_CONF_OVERRIDE)) {
		push(args, "--release-conf");
		push(args, UPD_CONF_OVERRIDE);
	}
	let q = "";
	for (let i = 0; i < length(args); i++)
		q += (i > 0 ? " " : "") + shellquote("" + args[i]);
	let inner = "CSQTT_INSTALLER_NOTES_FILE=" + shellquote(UPD_DIR + "/release.json") + " " +
		"CSQTT_INSTALLER_PLAN_FILE=" + shellquote(UPD_PLAN) + " " + q;
	let cmd = "(" + inner + " >" + shellquote(UPD_DIR + "/log") + " 2>&1; echo $? >" +
		shellquote(UPD_DIR + "/rc") + ") >/dev/null 2>&1 & echo $!";
	let p = fs.popen(cmd, "r");
	let pid = "";
	if (p != null) {
		let line;
		while ((line = p.read("line")) != null)
			pid += line;
		p.close();
	}
	pid = strip(pid);
	if (match(pid, UPD_PID_RE) == null) {
		updWrite(UPD_DIR + "/rc", "127\n");
		return { ok: false, error: "не удалось запустить установщик" };
	}
	updWrite(UPD_DIR + "/pid", pid + "\n");
	return { ok: true, pid: pid };
}

function mCheckUpdates(req) {
	let inst = resolveInstance(req.args.instance);
	if (inst == null)
		return { ok: false, error: INSTANCE_ERR };
	if (!updExists(UPD_INSTALLER))
		return { ok: false, configured: false,
			error: "установщик обновлений не найден: " + UPD_INSTALLER };
	let component = (type(req.args.component) == "string") ? req.args.component : "";
	if (component == "" || component == "both")
		component = "both";
	else if (component != "core" && component != "panel")
		return { ok: false, error: "неизвестный компонент: " + component };
	let st = updJob();
	if (st.running)
		return { ok: false, busy: true,
			error: "уже выполняется задание обновления (" + st.job + ")" };
	let coreVersion = req.args.core_branch || "2.5.3";
	if (coreVersion != "2.1.9" && coreVersion != "2.5.3")
		return { ok: false, error: "неизвестная ветка ядра" };
	let r = updSpawn("check", component, "check", null, coreVersion);
	if (!r.ok)
		return { ok: false, error: r.error };
	return { ok: true, started: true, job: "check", component: component };
}

// План последней успешной проверки. Битый/отсутствующий план = проверки нет:
// установка по памяти браузера или по «текущему latest» запрещена.
function updPlan() {
	let txt = updRead(UPD_PLAN);
	if (txt == null || txt == "")
		return null;
	let j = null;
	try { j = json(txt); } catch (e) { return null; }
	if (j == null || type(j) != "object")
		return null;
	if (type(j.tag) != "string" || match(j.tag, UPD_TAG_RE) == null)
		return null;
	if (j.components == null || type(j.components) != "object")
		return null;
	return j;
}

// Компонент из плана в виде, пригодном для передачи установщику.
function updPinned(plan, component) {
	if (plan == null)
		return null;
	let pc = plan.components[component];
	if (pc == null || type(pc) != "object")
		return null;
	let state = (type(pc.state) == "string") ? pc.state : "";
	if (state != "update" && state != "not_installed")
		return null;
	let name = (type(pc.name) == "string") ? pc.name : "";
	let sha256 = (type(pc.sha256) == "string") ? pc.sha256 : "";
	let version = (type(pc.available) == "string") ? pc.available : "";
	if (match(name, UPD_NAME_RE) == null || match(sha256, UPD_SHA_RE) == null ||
		match(version, UPD_VER_RE) == null)
		return null;
	return { tag: plan.tag, name: name, sha256: sha256, version: version };
}

function mInstallComponent(req) {
	let inst = resolveInstance(req.args.instance);
	if (inst == null)
		return { ok: false, error: INSTANCE_ERR };
	if (req.args.confirm !== true && req.args.confirm !== 1)
		return { ok: false, error: "установка требует явного подтверждения" };
	if (!updExists(UPD_INSTALLER))
		return { ok: false, configured: false,
			error: "установщик обновлений не найден: " + UPD_INSTALLER };
	let component = (type(req.args.component) == "string") ? req.args.component : "";
	if (component != "core" && component != "panel")
		return { ok: false, error: "неизвестный компонент: " + component };
	let st = updJob();
	if (st.running)
		return { ok: false, busy: true,
			error: "уже выполняется задание обновления (" + st.job + ")" };
	// Установка привязана к завершённой проверке: без плана или с компонентом,
	// который не проверялся, запуск отклоняется — нужна новая проверка.
	let plan = updPlan();
	if (plan == null)
		return { ok: false, need_check: true,
			error: "нет завершённой проверки обновлений: повторите проверку" };
	let pin = updPinned(plan, component);
	if (pin == null)
		return { ok: false, need_check: true,
			error: "компонент " + component + " не подтверждён проверкой: повторите проверку обновлений" };
	let coreVersion = req.args.core_branch || "2.5.3";
	if (component == "core" && (
		(coreVersion != "2.1.9" && coreVersion != "2.5.3") ||
		index(pin.name, "csqtt-core-" + coreVersion + "-") != 0 &&
		index(pin.name, "csqtt-core-" + coreVersion + "_") != 0))
		return { ok: false, need_check: true, error: "проверьте обновления для выбранной ветки ядра" };
	let pv = packageVersions();
	let present = (component == "core")
		? (pv["csqtt-core-" + coreVersion] || "") : (pv["luci-app-csqtt"] || "");
	let legacy = (component == "core")
		? (pv["csqtt-core-2.5.0"] || pv["csqtt-core-2.1.9"] || "") : "";
	// 2.5.3 ещё нет, а старое ядро есть — это явный переход, а не update.
	let action = (present != "") ? "update" : "install";
	let r = updSpawn("install", component, action, pin, coreVersion);
	if (!r.ok)
		return { ok: false, error: r.error };
	return {
		ok: true, started: true, job: "install", component: component,
		action: action,
		transition: (component == "core" && present == "" && legacy != ""),
		checked: { tag: pin.tag, name: pin.name, sha256: pin.sha256, version: pin.version },
	};
}

function mUpdateStatus(req) {
	let inst = resolveInstance(req.args.instance);
	if (inst == null)
		return { ok: false, error: INSTANCE_ERR };
	let st = updJob();
	let m = updParse(st.log);
	let pv = packageVersions();
	let coreMarker = m.components.core || null;
	let corePackage = "csqtt-core-2.5.3";
	if (coreMarker != null && type(coreMarker.name) == "string" &&
	    (index(coreMarker.name, "csqtt-core-2.1.9-") == 0 ||
	     index(coreMarker.name, "csqtt-core-2.1.9_") == 0))
		corePackage = "csqtt-core-2.1.9";
	let result = updResult(st, m);
	let error = null;
	if (result == "not_configured")
		error = "выпуск не настроен: не заданы owner/repo/tag";
	else if (result == "not_published")
		error = "опубликованный выпуск не найден в GitHub Releases";
	else if (result == "network")
		error = "не удалось получить данные выпуска: сеть или файл недоступен";
	else if (result == "no_package")
		error = "в выпуске нет подходящего пакета для этой системы";
	else if (result == "rolled_back")
		error = "установка не удалась; прежнее состояние восстановлено, откат доступен командой из журнала";
	else if (result == "artifact_changed")
		error = "проверенный пакет изменился или исчез в выпуске; повторите проверку обновлений";
	else if (result == "error")
		error = (m.failed != null && m.failed.message != "") ? m.failed.message
			: ((m.check_failed != null)
				? "проверка не удалась: " + (m.check_failed.stage || "-") + "/" + (m.check_failed.reason || "-")
				: "задание завершилось с ошибкой");
	return {
		ok: true,
		instance: "main",
		configured: updExists(UPD_INSTALLER),
		job: (st.job != "") ? st.job : null,
		component: (st.component != "") ? st.component : null,
		running: st.running,
		finished: (st.job != "" && !st.running),
		rc: st.rc,
		started: st.started,
		result: result,
		need_check: (result == "artifact_changed"),
		release: m.release,
		system: m.system,
		installed: {
			core: pv["csqtt-core-2.5.3"] || "",
			core_219: pv["csqtt-core-2.1.9"] || "",
			panel: pv["luci-app-csqtt"] || "",
			legacy_core: pv["csqtt-core-2.5.0"] || pv["csqtt-core-2.1.9"] || "",
		},
		components: {
			core: updComponent(coreMarker, pv[corePackage] || ""),
			panel: updComponent(m.components.panel || null, pv["luci-app-csqtt"] || ""),
		},
		notes: updNotes(),
		rollback: {
			core: "sh " + UPD_INSTALLER + " rollback --set core",
			panel: "sh " + UPD_INSTALLER + " rollback --set panel",
		},
		log: updTail(st.log, UPD_LOG_MAX),
		error: error,
	};
}


