config csqtt 'main'
	option enabled '0'
	option startup_wait '180'
	option ifname 'csqtt0'
	option selection_mode 'manual'
	option active_profile 'profile1'
	option failover '0'
	option failback '0'
	option health_interval '15'
	option fail_threshold '3'
	option success_threshold '2'
	option cooldown '60'
	option reconnect_delay '5'
	option failback_stable_time '60'
	option health_mode 'both'
	option health_target ''
	option captcha_policy 'wait'
	option tun_mtu '1300'
	option tun_address ''
	option dns ''
	option log_level 'info'
	option core_version 'auto'
	option log_file '/var/log/csqtt.log'
	option log_size_kb '512'
	option vk ''
	option vk_js_token ''
	option vk_hash_mode 'manual'
	option vk_auth_mode 'vkcalls'
	option workers '9'
	option runtime_threads '0'
	option listen '127.0.0.1:9000'
	option obfs 'unified'
	option turn_transport 'udp'
	option srtp_mode 'auto'
	option fingerprint 'chrome'
	option captcha_mode 'auto'
	option client_ids ''
	option turn ''
	option turn_port ''
	option custom_turn_ips ''
	option no_tun '0'
	option exact_workers '0'
	option domain_routing '0'
	option exclude_ru_zones '0'
	option template_domains '0'
	option domain_whitelist '0'
	option direct_domains ''
	option ip_routing '0'
	option ip_whitelist '0'
	option direct_ips ''
	option schema_version '2'

config csqtt 'routing'
	option mode 'auto'

config server 'profile1'
	option name 'Основной сервер'
	option enabled '0'
	option priority '10'
	option peer ''
	option password ''
	option note 'Заполните адрес и пароль перед первым запуском'
