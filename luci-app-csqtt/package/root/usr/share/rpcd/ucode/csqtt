function mAccessCheck(req) {
	let status = statusObject();
	if (!status.running || !status.interface_up)
		return { ok: false, instance: "main", error: "tunnel interface is not ready" };
	let target = accessTarget(req.args.target);
	if (target == null)
		return { ok: false, instance: "main", error: "unsupported access-check target" };
	let ifname = status.interface;
	if (match(ifname, IFNAME_RE) == null)
		return { ok: false, instance: "main", error: "invalid tunnel interface" };
	let result = run(["/usr/bin/curl", "-4", "--location", "--silent", "--show-error",
		"--connect-timeout", "10", "--max-time", "12", "--retry", "1", "--retry-delay", "1", "--retry-max-time", "12", "--interface", ifname,
		"--output", "/dev/null", "--write-out", "\n%{http_code}", target.url]);
	let output = clean(result.out), lines = split(output, "\n");
	let httpCode = length(lines) > 0 ? int(lines[length(lines) - 1]) : 0;
	let success = result.code == 0 && httpCode >= 200 && httpCode < 400;
	let reason = success ? "HTTP " + httpCode : (httpCode > 0 ? "HTTP " + httpCode : output);
	if (reason == "") reason = "curl exited with code " + result.code;
	if (length(reason) > 240) reason = substr(reason, 0, 240) + "…";
	let record = {
		state: success ? "ok" : "failed",
		target_id: target.id,
		target: target.name,
		url: target.url,
		ifname: ifname,
		http_code: httpCode,
		reason: reason,
		checked_at: time(),
		started_at: status.status != null ? status.status.started_at : null
	};
	if (!writeJson(ACCESS_STATUS_PATH, record))
		return { ok: false, instance: "main", error: "unable to save access-check result" };
	return { ok: true, success: success, instance: "main", result: record };
}

